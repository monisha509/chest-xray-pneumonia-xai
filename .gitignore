# ─────────────────────────────────────────────
#  ChestXR — .gitignore
# ─────────────────────────────────────────────

# ── Dataset & raw images ─────────────────────
data/raw/
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.tif
*.dcm

# ── Archive / zip files ───────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ── Trained model artefacts ───────────────────
models/
*.h5
*.keras
*.pt
*.pth
*.onnx
*.pb
*.tflite
*.pkl
*.pickle
*.joblib

# ── Python cache & build ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Virtual environments ──────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Environment / secrets ─────────────────────
.env
.env.*
*.env
secrets.yaml
secrets.json

# ── Jupyter Notebooks ─────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDEs & editors ────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
